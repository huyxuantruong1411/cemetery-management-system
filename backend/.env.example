# Database Settings (MSSQL)
DB_SERVER=DESKTOP-HKIPI1M
DB_NAME=QL_NghiaTrang
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_AUTH=windows
DB_USER=
DB_PASSWORD=
