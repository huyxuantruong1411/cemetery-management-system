# MinIO / S3 Storage Settings
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=admin_local
STORAGE_SECRET_KEY=NghiaTrangSecret2026!
STORAGE_BUCKET=nghiatrang-private
STORAGE_REGION=us-east-1
RUNTIME_DIR=./runtime

# Docker Compose MinIO
MINIO_IMAGE=elestio/minio:latest
MINIO_ROOT_USER=admin_local
MINIO_ROOT_PASSWORD=NghiaTrangSecret2026!

# Security & JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production-cemetery-2026
